rules_version = '2';

// ---------------------------------------------------------------------------
// Express Invoicing — Firestore security rules
//
// This is a SINGLE-USER system. Exactly one Firebase Auth account exists (the
// shop owner). There are no roles and no permission matrix, so these rules have
// exactly one job: let that one account in, and nobody else.
//
// ---------------------------------------------------------------------------
// SET THIS UP IN THREE STEPS
// ---------------------------------------------------------------------------
//
// 1. Firebase console -> Authentication -> Sign-in method: enable
//    Email/Password. Then Users -> Add user, and create the owner account.
//
// 2. Authentication -> Settings -> User actions: turn OFF "Enable create
//    (sign-up)". This is the switch that stops the internet from making
//    accounts on your project. Do not skip it.
//
// 3. Fill in ownerEmail() or ownerUid() below and deploy:
//       firebase deploy --only firestore:rules
//
//    Use ownerEmail() if you are setting this up before your first sign-in —
//    you already know the address. Use ownerUid() once you have signed in and
//    copied the UID from the Settings screen; it is the stronger of the two,
//    because a UID cannot be changed while an email address can be.
//
//    Setting either one is enough. Setting both requires both to match.
//
// If both are left blank, any signed-in account can read and write. With
// sign-up disabled that is still a closed system, but it is one console
// misclick away from not being one — so fill one in.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // e.g. 'you@example.com'  — leave '' to skip this check
    function ownerEmail() {
      return '';
    }

    // e.g. 'a1B2c3D4e5F6g7H8i9J0kLmNoP1'  — leave '' to skip this check
    function ownerUid() {
      return '';
    }

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner() {
      return signedIn()
        && (ownerUid() == '' || request.auth.uid == ownerUid())
        && (ownerEmail() == '' || request.auth.token.email == ownerEmail());
    }

    // -----------------------------------------------------------------------
    // The collections this app actually uses.
    //
    // They are listed one by one rather than with a wildcard so that a typo in
    // a collection name fails loudly instead of quietly creating a stray
    // collection that nothing reads.
    // -----------------------------------------------------------------------

    // Business details, logo, tax rates, defaults.
    match /settings/{docId} {
      allow read, write: if isOwner();
    }

    // Next number / prefix / padding per document type.
    match /counters/{docId} {
      allow read, write: if isOwner();
    }

    match /customers/{docId} {
      allow read, write: if isOwner();
    }

    match /items/{docId} {
      allow read, write: if isOwner();
    }

    match /invoices/{docId} {
      allow read, write: if isOwner();
    }

    match /quotes/{docId} {
      allow read, write: if isOwner();
    }

    match /orders/{docId} {
      allow read, write: if isOwner();
    }

    match /payments/{docId} {
      allow read, write: if isOwner();
    }

    match /recurring/{docId} {
      allow read, write: if isOwner();
    }

    // Import batch bookkeeping, so a half-finished migration can be resumed.
    match /imports/{docId} {
      allow read, write: if isOwner();
    }

    // Anything not named above is denied outright, signed in or not.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
